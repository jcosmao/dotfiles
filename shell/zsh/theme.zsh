function __get_host_color
{
  # deterministic color from hostname, pure zsh (no fork)
  local -a colors=(10 11 12 14 39 45 69 99 123 135 159 161 202 208 219)
  local c hash=0
  for c in ${(s::)HOST}; do (( hash = (hash * 31 + #c) % 1000003 )); done
  echo ${colors[$(( hash % $#colors + 1 ))]}
}

