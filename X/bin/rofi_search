#!/usr/bin/env python

import argparse
import glob
import html
import logging
import os
import re
import shutil
import sqlite3
import subprocess
import sys
import tempfile
import time
import urllib.parse

import yaml

LOG = logging.getLogger()

HISTORY_FILE = os.path.expanduser("~/.cache/rofi_search_history")
HISTORY_MAX = 50
BOOKMARK_PREFIX = r"^b(?::\s*|\s+)(.*)$"


class Rofi:
    def select(self, prompt, options, search):
        """Returns (selected_option, returncode).

        returncode 10 = kb-custom-1 (Alt+c) pressed.
        """
        rofi_process = subprocess.Popen(
            [
                "rofi",
                "-dmenu",
                "-p",
                "",
                "-markup",
                "-i",
                "-l",
                str(len(options)),
                "-kb-custom-1",
                "Alt+c",
                "-mesg",
                f"<small><b>string:</b> {search}   "
                f"<i>(Alt+c: clear selection)</i></small>",
                "-theme-str",
                f'entry {{placeholder: "{prompt}";}} window {{width: 900px;}}',
            ],
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            text=True,
        )
        stdout, _ = rofi_process.communicate("\n".join(options) + "\n")
        return stdout.strip(), rofi_process.returncode

    def prompt(self, prompt, options, filter_text="", mesg=""):
        """Prompt with fuzzy-searchable options. Free text input allowed.

        Returns (user_input, returncode). returncode 10 = kb-custom-1 (Alt+c).
        """
        command = [
            "rofi",
            "-dmenu",
            "-p",
            "",
            "-i",
            "-matching",
            "fuzzy",
            "-sort",
            "-sorting-method",
            "fzf",
            "-l",
            "10",
            "-kb-custom-1",
            "Alt+c",
            "-theme-str",
            f'entry {{placeholder: "{prompt}";}} window {{width: 900px;}}',
        ]
        if filter_text:
            command += ["-filter", filter_text]
        if mesg:
            command += ["-mesg", mesg]
        rofi_process = subprocess.Popen(
            command,
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            text=True,
        )
        stdout, _ = rofi_process.communicate("\n".join(options) + "\n")
        return stdout.strip(), rofi_process.returncode


def load_config(file_path):
    """
    Parse yaml config
    Args:
        file_path (string):

    ```yaml
    - match: '(regex capture group)'
      items:
        - title: "title: $1"
          url: 'https://search.com/?q=$1'
    ```

    Returns: []
    """
    try:
        with open(file_path, "r") as file:
            return yaml.safe_load(file)
    except Exception:
        LOG.exception("Fail to read file")
        return []


def load_history():
    try:
        with open(HISTORY_FILE, "r") as file:
            return [line.strip() for line in file if line.strip()]
    except FileNotFoundError:
        return []


def save_history(entry):
    entry = entry.strip()
    if not entry:
        return
    history = [h for h in load_history() if h != entry]
    history.insert(0, entry)
    os.makedirs(os.path.dirname(HISTORY_FILE), exist_ok=True)
    with open(HISTORY_FILE, "w") as file:
        file.write("\n".join(history[:HISTORY_MAX]) + "\n")


def get_matches(user_input, config):
    matched_items = []
    seen = set()
    for entry in config:
        try:
            match = re.match(entry["match"], user_input)
        except Exception:
            LOG.error(f"error match - {entry['match']}")
            continue

        if match:
            for item in entry["items"]:
                title = re.sub(
                    r"\$(\d+)",
                    lambda m: match.group(int(m.group(1))),
                    item["title"],
                )
                if re.fullmatch(r"\$\d+", item["url"]):
                    # url template is the capture itself (e.g. 'Open url'):
                    # keep it raw, encoding would break it
                    url = match.group(int(item["url"][1:]))
                else:
                    # url-encode captured groups so queries with spaces/special
                    # chars stay valid in the target url
                    url = re.sub(
                        r"\$(\d+)",
                        lambda m: urllib.parse.quote(
                            match.group(int(m.group(1))), safe=""
                        ),
                        item["url"],
                    )
                # several config entries can produce the same item: dedupe
                if (title, url) in seen:
                    continue
                seen.add((title, url))
                matched_items.append((title, url))

    return matched_items


def get_keywords(config):
    """Extract [(keyword, description)] from config regexes.

    Keywords are prefixes like 'jira:' or 'go/', description comes from
    the entry's first item title ('$1' parts stripped).
    """
    keywords = [("b:", "firefox bookmarks")]
    for entry in config:
        pattern = entry["match"]
        desc = re.sub(r"[:\s]*\$\d+.*$", "", entry["items"][0]["title"])
        m = re.match(r"\^(?:\(\?:)?([a-z0-9|._-]+)\)?\(\?::", pattern)
        if m:
            keywords.append((f"{m.group(1).split('|')[0]}:", desc))
            continue
        m = re.match(r"\^([a-z0-9-]+/)\(", pattern)
        if m:
            keywords.append((m.group(1), desc))
    return keywords


def keywords_helper(config):
    keywords = [
        (kw, desc[:18] + "…" if len(desc) > 19 else desc)
        for kw, desc in get_keywords(config)
    ]
    width = max(len(f"{kw} {desc}") for kw, desc in keywords) + 2

    def cell(kw, desc):
        pad = " " * (width - len(f"{kw} {desc}"))
        return f"<b>{html.escape(kw)}</b> {html.escape(desc)}{pad}"

    lines = []
    for i in range(0, len(keywords), 3):
        group = keywords[i : i + 3]
        lines.append("".join(cell(kw, desc) for kw, desc in group).rstrip())

    lines[-1] += f"{' ' * 3}<i>Alt+c: clear</i>"
    body = "\n".join(lines)
    return f"<tt><span size='10000'>{body.strip()}</span></tt>"


def get_firefox_bookmarks():
    """Return [(title, url)] from firefox places.sqlite (most recent profile)."""
    places_files = glob.glob(os.path.expanduser("~/.mozilla/firefox/*/places.sqlite"))
    if not places_files:
        return []
    places = max(places_files, key=os.path.getmtime)

    bookmarks = []
    with tempfile.TemporaryDirectory() as tmpdir:
        # work on a copy: firefox keeps the db locked while running
        db_copy = os.path.join(tmpdir, "places.sqlite")
        shutil.copy(places, db_copy)
        wal = f"{places}-wal"
        if os.path.exists(wal):
            shutil.copy(wal, f"{db_copy}-wal")
        try:
            conn = sqlite3.connect(db_copy)
            rows = conn.execute(
                """
                SELECT f.title, b.title, p.url
                FROM moz_bookmarks b
                JOIN moz_places p ON b.fk = p.id
                LEFT JOIN moz_bookmarks f ON b.parent = f.id
                WHERE b.type = 1 AND p.url LIKE 'http%'
                ORDER BY b.dateAdded DESC
                """
            ).fetchall()
            conn.close()
        except sqlite3.Error:
            LOG.exception("fail to read firefox bookmarks")
            return []

    seen = set()
    for folder, title, url in rows:
        if url in seen:
            continue
        seen.add(url)
        title = title or url
        display = f"{folder}/{title}" if folder else title
        bookmarks.append((display, url))
    return bookmarks


def bookmark_search(rofi, query):
    bookmarks = get_firefox_bookmarks()
    if not bookmarks:
        return

    display_map = {display: url for display, url in bookmarks}
    selected, _ = rofi.prompt("bookmarks", list(display_map), filter_text=query)
    if selected in display_map:
        save_history("b:")
        open_url(display_map[selected])


def open_url(url):
    subprocess.run(["xdg-open", url])
    time.sleep(0.3)
    subprocess.run(["i3-msg", "[urgent=latest] focus"])


def clear_selection():
    for selection in ("primary", "clipboard"):
        subprocess.run(["xclip", "-i", "/dev/null", "-selection", selection])


def read_primary_selection():
    try:
        return (
            subprocess.check_output(
                ["xclip", "-out", "-selection", "primary"],
                stderr=subprocess.DEVNULL,
            )
            .decode("utf-8")
            .strip()
        )
    except subprocess.CalledProcessError:
        return ""


def search(rofi, user_input, config, keep_history=True):
    bookmark = re.match(BOOKMARK_PREFIX, user_input)
    if bookmark:
        bookmark_search(rofi, bookmark.group(1))
        return

    matched_items = get_matches(user_input, config)
    if not matched_items:
        # Fallback on google search
        if keep_history:
            save_history(user_input)
        open_url(f"https://www.google.com/search?q={urllib.parse.quote(user_input)}")
        return

    options = [item[0] for item in matched_items]

    if len(options) == 1:
        selected_option = options[0]
    else:
        selected_option, returncode = rofi.select(
            "Select an option ", options, search=user_input
        )
        if returncode == 10:
            clear_selection()
            return "clear"

    for title, url in matched_items:
        if title == selected_option:
            if keep_history:
                save_history(user_input)
            open_url(url)
            break


def main(args):
    rofi = Rofi()
    config = load_config(args.config)

    clipboard = read_primary_selection()

    # selection matching a config entry: straight to the match menu,
    # without saving this one-shot value (uuid, hostname, ...) in history
    if clipboard and get_matches(clipboard, config):
        # Alt+c in the menu clears the selection and falls back to the prompt
        if search(rofi, clipboard, config, keep_history=False) != "clear":
            return

    mesg = keywords_helper(config)
    while True:
        user_input, returncode = rofi.prompt("search", load_history(), mesg=mesg)
        if returncode == 10:
            clear_selection()
            clipboard = ""
            continue
        break

    if not user_input:
        sys.exit(0)

    search(rofi, user_input, config, keep_history=(user_input != clipboard))


def parse_args():
    """
    Parse command line args
    """
    default_conf = f"{os.getenv('HOME')}/.config/rofi-search.yaml"
    parser = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    parser.add_argument(
        "--config", help="yaml config file", metavar=default_conf, default=default_conf
    )
    parser.add_argument("--debug", help="trigger debug mode", action="store_true")

    args = parser.parse_args()
    return args


if __name__ == "__main__":
    args = parse_args()
    logging.basicConfig(level=logging.INFO, format="[%(levelname)8s]  %(message)s")

    if args.debug:
        logging.getLogger().setLevel(logging.DEBUG)

    main(args)
